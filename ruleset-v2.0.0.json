    {"rule_id":"FXM006","severity":"error","message":"node_version must be 16 or 22.","docs_url":"https://docs.fivem.net/docs/scripting-reference/resource-manifest/#node_version"},
    {"rule_id":"FXM007","severity":"warning","message":"A singleton directive is declared more than once.","docs_url":"https://docs.fivem.net/docs/scripting-reference/resource-manifest/"},
